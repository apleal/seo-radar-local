# SEO Radar Local - copia este archivo como .env. Nunca publiques .env.

# Datos reales (DataForSEO, pago por uso)
DATAFORSEO_LOGIN=tu-correo@example.com
DATAFORSEO_PASSWORD=contraseña_api_segura

# Acceso para el modo alojado con Cloudflare (no protege por sí solo Easypanel)
ACCESS_KEY=elige-una-clave-larga-y-unica
AUTH_SALT=genera-un-valor-aleatorio-largo

# Marca
BRAND_NAME=SEO Radar Local
# LOGO_FILE=/app/credentials/logo.svg

# Servidor y programación
PORT=8000
DAILY_REFRESH_HOUR=6

# Google Search Console (opcional)
# GSC_CLIENT_SECRET=/app/credentials/gsc-client-secret.json
# GSC_TOKENS=/app/credentials/gsc-tokens.json

# Telegram (opcional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Cloudflare Pages Functions (opcional; necesario para botones interactivos)
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_PAGES_PROJECT=seo-radar-local
# CF_KV_NAMESPACE=
